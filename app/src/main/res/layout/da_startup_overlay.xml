<?xml version="1.0" encoding="utf-8"?>
<!-- Splash Overlay for controlled delay and branding text -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splash_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/da_background"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center">
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:src="@drawable/ic_android_auto" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-10dp"
            android:text="@string/da_brand"
            android:textColor="@color/splash_text_white"
            android:textSize="24sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-4dp"
            android:text="@string/da_wireless"
            android:textAllCaps="true"
            android:textColor="@color/da_accent"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>
</RelativeLayout>
